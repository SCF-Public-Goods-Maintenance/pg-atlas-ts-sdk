{
  "name": "@pg-atlas/data-sdk",
  "version": "0.8.0",
  "description": "TypeScript SDK for the PG Atlas API",
  "keywords": [
    "stellar",
    "soroban",
    "public-goods",
    "atlas",
    "sdk"
  ],
  "author": "PG Atlas Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=26.13.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SCF-Public-Goods-Maintenance/pg-atlas-ts-sdk.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "generate": "openapi-ts",
    "update": "node ./scripts/update-api.cjs && pnpm run generate",
    "rewrite-tests": "node ./scripts/rewrite-tests.cjs",
    "test": "vitest run src/index.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.22.0",
      "onFail": "download"
    }
  }
}
